# Biodata Management System - Environment Configuration
# Copy to .env and fill in. Every setting is optional unless noted.

# --------------------------------
# Security (strongly recommended)
# --------------------------------
# The app stores personal data (names, phone numbers, family details).
# When both are set, every page and API call requires HTTP Basic auth.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Comma-separated origins allowed to call the API from other sites (empty = same-origin only)
CORS_ORIGINS=

# --------------------------------
# OCR provider: "nvidia", "vertexai", "anthropic", or "local" (no extraction, for development)
# --------------------------------
LLM_PROVIDER=nvidia

# Vertex AI (Gemini). Auth uses Application Default Credentials:
#   gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
# Newer Gemini models are only served from the "global" location
GCP_LOCATION=global
VERTEX_MODEL=gemini-3-flash-preview
# Models selectable in the UI (JSON list)
# AVAILABLE_MODELS=["gemini-3-flash-preview"]

# NVIDIA NIM (https://build.nvidia.com). Two stages: a vision model reads each page,
# then Nemotron Ultra extracts the fields. PDFs with a text layer skip the vision step.
NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_ENABLE_THINKING=false     # true = slower, more deliberate extraction
# NVIDIA_MAX_PDF_PAGES=4

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --------------------------------
# Telegram bot (optional)
# --------------------------------
# Send biodata PDFs/photos to your bot to upload them. Create a bot with @BotFather.
# Only these chat IDs can use it; anyone else is told their chat ID (comma-separated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --------------------------------
# Neo4j graph view (optional)
# --------------------------------
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# On newer Aura instances the database is named after the instance ID, not "neo4j"
NEO4J_DATABASE=neo4j

# --------------------------------
# Storage
# --------------------------------
# UPLOAD_DIR=./uploads
# DB_DIR=./backend/db
MAX_FILE_SIZE_MB=10

# --------------------------------
# Rate limiting & retries
# --------------------------------
QUEUE_CONCURRENCY=5          # Max concurrent OCR calls
REQUESTS_PER_MINUTE=50       # Stay under your provider quota
BURST_CAPACITY=10
MAX_RETRIES=3                # Retries for 429/5xx/timeouts
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0
MAX_BULK_FILES=200

# --------------------------------
# App
# --------------------------------
DEBUG=false                  # true enables auto-reload with run.py
LOG_LEVEL=INFO
